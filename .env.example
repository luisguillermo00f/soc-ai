# SOC AI. Copia este archivo como .env y completa los valores.

# Puerto HTTP del servidor (sirve la API y la interfaz).
PORT=5230

# Clave de la API de Anthropic. Sin ella, SOC AI funciona con el motor de reglas
# (estadística completa, planes basados en la biblioteca SST) y desactiva el razonamiento con Claude.
# Nunca se envía al navegador.
ANTHROPIC_API_KEY=

# IA gratuita (se usan si no hay clave de Anthropic). Orden: Gemini y, si está saturado, Groq.
# Gemini: https://aistudio.google.com/apikey   Groq: https://console.groq.com/keys
GEMINI_API_KEY=
# Modelos de Gemini a probar en orden (opcional).
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Modelo y esfuerzo de razonamiento para los análisis con Claude.
SOC_AI_MODEL=claude-opus-5-5
SOC_AI_EFFORT=high

# Secreto para seudonimizar trabajadores (HMAC) y firmar sesiones.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si cambia, los seudónimos de trabajadores cambian en las próximas importaciones.
SOC_AI_SECRET=

# Ruta de la base de datos SQLite.
SOC_AI_DB=data/soc-ai.db
